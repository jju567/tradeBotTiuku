[Unit]
Description=tradeBotTiuku Paper Trader Live Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tradeBotTiuku
Environment="PATH=/opt/tradeBotTiuku/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/opt/tradeBotTiuku/.env
ExecStart=/opt/tradeBotTiuku/venv/bin/python main_controller.py --loop --interval-hours 4
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
