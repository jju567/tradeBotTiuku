[Unit]
Description=tradeBotTiuku Paper Trader Live Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tradeBotTiuku
Environment="PATH=/home/ubuntu/tradeBotTiuku/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/home/ubuntu/tradeBotTiuku/.env
ExecStart=/home/ubuntu/tradeBotTiuku/venv/bin/python main_controller.py --schedule --daily-at 23:05 --no-initial-run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
