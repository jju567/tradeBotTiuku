[Unit]
Description=tradeBotTiuku Streamlit Web UI Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tradeBotTiuku
Environment="PATH=/home/ubuntu/tradeBotTiuku/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/home/ubuntu/tradeBotTiuku/.env
ExecStart=/home/ubuntu/tradeBotTiuku/venv/bin/streamlit run dashboard.py --server.port 8502 --server.headless true
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
