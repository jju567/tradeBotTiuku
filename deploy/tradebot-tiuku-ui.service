[Unit]
Description=tradeBotTiuku Streamlit Web UI Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tradeBotTiuku
Environment="PATH=/opt/tradeBotTiuku/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/opt/tradeBotTiuku/.env
ExecStart=/opt/tradeBotTiuku/venv/bin/streamlit run dashboard.py --server.port 8502 --server.headless true
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
