[Unit]
Description=tradeBotTiuku Unified Service (Streamlit UI + Paper Trader Daemon)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tradeBotTiuku
Environment="PATH=/home/ubuntu/tradeBotTiuku/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/home/ubuntu/tradeBotTiuku/.env
ExecStart=/home/ubuntu/tradeBotTiuku/venv/bin/python start_all.py --port 8502 --schedule --daily-at 23:05
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
