# OpenAI API Settings
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

# Nordnet Brokerage Fee Tiers
# Taso 3 (1-10 kauppaa/kk): min 7.00 EUR / 0.15%
# Taso 2 (11-50 kauppaa/kk): min 5.00 EUR / 0.10%
# Taso 1 (>50 kauppaa/kk): min 3.00 EUR / 0.06%
NORDNET_FEE_TIER=3
COMMISSION_MIN_EUR=7.00
COMMISSION_PERCENT=0.0015

# Portfolio & Currency
CURRENCY="EUR"
INITIAL_BALANCE=10000.0

# Rebalancing & Trading Safety Thresholds
REBALANCE_INTERVAL_DAYS=7
MIN_TRADE_EUR=200.0          # Minimum trade size in EUR to avoid brokerage fee erosion
MAX_POSITION_WEIGHT=0.20      # Maximum allocation weight for a single stock (20%)
TARGET_CASH_PERCENT=0.05      # Target cash buffer percentage (5%)
STOP_LOSS_PERCENT=0.15        # Hard stop-loss threshold (15% drop)

# Automation & Reporting
WEEKLY_REPORT_DAY="monday"     # Day of week for weekly rebalancing analysis
REPORT_OUTPUT_DIR="reports"

# Email Reporting Settings (SMTP)
ENABLE_EMAIL_REPORTS="false"   # Set to "true" to send weekly report & HTML dashboard via email
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_TO="recipient-email@domain.com"
EMAIL_FROM="your-email@gmail.com"

# Directories
DATA_DIR="data"
LOG_DIR="logs"
